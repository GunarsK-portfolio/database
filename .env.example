# Database Configuration
# For local development with docker-compose

# Database Name
POSTGRES_DB=portfolio

# PostgreSQL Superuser (for initial database creation)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_pass

# Flyway Migration User (DDL rights - creates/alters tables)
# Used by: Flyway migrations
FLYWAY_USER=portfolio_owner
FLYWAY_PASSWORD=portfolio_owner_dev_pass

# Application API User (CRUD rights - SELECT/INSERT/UPDATE/DELETE)
# Used by: admin-api, auth-service
DB_USER=portfolio_admin
DB_PASSWORD=portfolio_admin_dev_pass

# Read-Only User (SELECT only)
# Used by: public-api (optional - for extra security)
DB_USER_READONLY=portfolio_public
DB_PASSWORD_READONLY=portfolio_public_dev_pass

# IMPORTANT: Change all passwords in production!
# Use environment variables or secrets management for production deployments
