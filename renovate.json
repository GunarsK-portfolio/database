{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    ":label(database)"
  ],
  "timezone": "Europe/Riga",
  "schedule": [
    "before 6am on monday"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "groupName": "PostgreSQL & related images",
      "automerge": false,
      "labels": [
        "docker",
        "postgres",
        "flyway"
      ],
      "matchPackageNames": [
        "/postgres/",
        "/flyway/"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "CI/CD workflows",
      "automerge": true,
      "labels": [
        "ci"
      ]
    }
  ],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "rebaseWhen": "behind-base-branch"
}
